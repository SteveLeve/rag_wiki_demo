# Copy to .env and edit. Real environment variables win over anything set here.
# Read by ragkit.config; see src/ragkit/config.py.

# --- PostgreSQL ---------------------------------------------------------
# Port 5433, not 5432. 5432 is routinely taken by another project's database,
# and these notebooks create and drop tables.
#
#   docker run -d --name rag-wiki-pgvector \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=rag_db \
#     -p 127.0.0.1:5433:5432 pgvector/pgvector:pg16
RAG_PG_HOST=localhost
RAG_PG_PORT=5433
RAG_PG_DATABASE=rag_db
RAG_PG_USER=postgres
RAG_PG_PASSWORD=postgres

# --- Models -------------------------------------------------------------
# Aliases come from the catalog in src/ragkit/models.py:
#   all_minilm_l6_v2 (384)   nomic_embed_text (768)   mxbai_embed_large (1024)
RAG_EMBEDDING_MODEL=nomic_embed_text
# llama3.2:1b is the documented fallback for constrained machines.
RAG_LLM_MODEL=llama3.2:3b

# --- Chunking and retrieval defaults ------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# --- Testing ------------------------------------------------------------
# Set to 1 to serve deterministic embeddings from ragkit.testing instead of
# calling Ollama. Lets the whole test suite and every notebook run with no
# model server and no downloads. Used by CI.
# RAG_FAKE_MODELS=1
